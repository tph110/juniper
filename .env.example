# Juniper API keys — copy to .env (or set in Vercel project settings).
# With NO keys set, the app runs fully in demo mode: canned patient replies
# and the browser's built-in voice.

# Patient dialogue LLM — https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional override; defaults to moonshotai/kimi-k2.6
LLM_MODEL=

# Patient voice — https://www.minimax.io (international platform)
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
# Optional override; defaults to speech-02-turbo
TTS_MODEL=

# Student voice input (speech-to-text) — https://console.deepgram.com
# Key must have the "Member" role (needed to mint temporary tokens).
# Without it, the app falls back to the browser's built-in recognition.
DEEPGRAM_API_KEY=
